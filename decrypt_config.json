{
  "_说明": "招标文件解压工具 解密配置（v1.2）。修改后无需重启，下次解压时自动读取。",
  "_用法": "把 enabled 改为 true 并填入官方软件中的 AES 密钥；verify_xml 会在解密结果不是 XML 时自动回退为导出密文并告警。",
  "exclude_files": [
    "PBZB.xml"
  ],
  "rules": {
    ".ahaqslzb": {
      "enabled": false,
      "algorithm": "AES",
      "mode": "CBC",
      "key_format": "hex",
      "key": "",
      "iv_format": "hex",
      "iv": "",
      "iv_from_ciphertext": false,
      "strip_pkcs7": true,
      "verify_xml": true
    }
  }
}
